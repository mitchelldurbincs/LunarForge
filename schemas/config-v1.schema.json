{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LunarForge repository policy, version 1",
  "description": "The JSON-compatible value of .lunarforge.yml. The CLI also rejects duplicate check IDs and multiple YAML documents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "verify"],
  "properties": {
    "version": { "const": 1 },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "run"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
              "run": { "type": "string", "pattern": "\\S" },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 0,
                "default": 1800,
                "description": "Omitting this field or setting it to zero uses the 30-minute default."
              }
            }
          }
        }
      }
    }
  }
}
